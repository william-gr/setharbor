   <intent-filter><action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/><data android:scheme="https" android:host="william-gr.github.io" android:path="/setharbor/open/"/></intent-filter>
  </activity>
 </application>
